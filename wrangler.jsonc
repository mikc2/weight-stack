{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weight-stack",
  "compatibility_date": "2026-10-22",
  // Static Vite build; unknown paths fall back to index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Branch builds run `wrangler preview`, which requires this block (empty is fine).
  "previews": {}
}
